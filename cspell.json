{
  "version": "0.2",
  "language": "pt-BR,en",
  "enabledLanguageIds": [
    "markdown",
    "quarto",
    "latex",
    "plaintext",
    "yaml",
    "bibtex",
    "biblatex"
  ],
  "files": [
    "**/*.{qmd,md,yml,yaml,bib}"
  ],
  "ignorePaths": [
    ".git/**",
    ".quarto/**",
    "_freeze/**",
    "docs/**",
    "_scratch/**",
    "**/node_modules/**",
    "assets/js/applets-dist/**",
    "**/*_files/**",
    "_interno/**/*.html",
    "**/package-lock.json",
    "*.pdf",
    "*.png",
    "*.jpg",
    "*.jpeg",
    "*.svg"
  ],
  "patterns": [
    {
      "name": "quarto-ids-classes",
      "pattern": "/(#|\\.)[A-Za-z][A-Za-z0-9_-]*/g"
    },
    {
      "name": "file-paths",
      "pattern": "/(?:[\\w.-]+\\/)+[\\w.-]+\\.[A-Za-z0-9]{1,5}\\b/g"
    },
    {
      "name": "file-names",
      "pattern": "/[\\w.-]+\\.(qmd|md|tex|bib|yml|yaml|json|scss|css|js|ts|html|pdf|png|jpg|jpeg|svg)/g"
    },
    {
      "name": "latex-commands",
      "pattern": "/\\\\[A-Za-z@]+\\*?/g"
    },
    {
      "name": "latex-symbol-commands",
      "pattern": "/\\\\[^A-Za-z\\s]/g"
    },
    {
      "name": "latex-references",
      "pattern": "/\\\\(?:label|ref|eqref|cref|Cref|autoref)\\{[^}]+\\}/g"
    },
    {
      "name": "latex-citations",
      "pattern": "/\\\\(?:cite|parencite|textcite|autocite)\\{[^}]+\\}/g"
    },
    {
      "name": "quarto-shortcodes",
      "pattern": "/\\{\\{<[^>]*>\\}\\}/g"
    },
    {
      "name": "quarto-crossrefs",
      "pattern": "/@[a-z]+-[\\w-]+/g"
    },
    {
      "name": "latex-environments",
      "pattern": "/\\\\(?:begin|end)\\{[^}]+\\}/g"
    },
    {
      "name": "markdown-link-targets",
      "pattern": "/\\]\\([^)]*\\)/g"
    },
    {
      "name": "markdown-inline-code",
      "pattern": "/`[^`\\n]*`/g"
    }
  ],
  "ignoreRegExpList": [
    "quarto-ids-classes",
    "file-paths",
    "file-names",
    "latex-commands",
    "latex-symbol-commands",
    "latex-references",
    "latex-citations",
    "quarto-shortcodes",
    "quarto-crossrefs",
    "latex-environments",
    "markdown-link-targets",
    "markdown-inline-code"
  ],
  "words": [
    "applet",
    "applets",
    "callout",
    "crossref",
    "Desmos",
    "frontmatter",
    "geogebra",
    "GeoGebra",
    "JSXGraph",
    "KaTeX",
    "MathJax",
    "Quarto",
    "Typst",
    "Vite"
  ]
}
